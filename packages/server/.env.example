PORT=5000

# Groq Cloud (Recommended: 100% Free, 14,400 req/day, sub-2s generation from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend URL(s) - set to your Vercel URL (e.g. https://my-app.vercel.app) or *
CORS_ORIGIN=*
